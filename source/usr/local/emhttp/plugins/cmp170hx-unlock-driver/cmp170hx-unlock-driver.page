  <p><input type="button" id="cmp-recheck" value="Re-check now" onclick="recheck()">
     <a class="button" href="/plugins/<?=$name?>/include/diag.php" style="margin-left:8px">Download diagnostics</a></p>
</div>

<div class="cmp-col">
  <p><b><font size="+1">Settings</font></b></p>
  <form method="post">
    <input type="hidden" name="csrf_token" value="<?=htmlspecialchars($var['csrf_token'] ?? '', ENT_QUOTES)?>">
    <table class="cmp-form">
      <tr><td><b>Nvidia driver version</b></td><td>
        <select id="cmp-drv" name="drv"><option value="<?=htmlspecialchars($cur['driver_version'])?>" selected><?=$cur['driver_version'] === 'latest' ? 'Latest' : htmlspecialchars($cur['driver_version'])?></option></select>
        <p class="cmp-note"><i>Latest</i> follows new published versions (needs update notifications on to download them automatically). Only versions published for your kernel are listed.</p></td></tr>
      <tr><td><b>cmpunlocker version</b></td><td>
        <select id="cmp-ref" name="ref"><option value="<?=htmlspecialchars($cur['cmpunlocker_ref'])?>" selected><?=$cur['cmpunlocker_ref'] === 'latest' ? 'Latest' : htmlspecialchars($cur['cmpunlocker_ref'])?></option></select>
        <p class="cmp-note">Only versions that were built and published for your kernel are listed.</p></td></tr>
      <tr><td><b>Card profile</b></td><td>
        <select name="profile">
          <?php foreach (['auto' => 'Auto-detect', '8gb' => '8 GB model (10de:20c2)', '10gb' => '10 GB model (10de:2082)', 'mixed' => 'Both models installed'] as $v => $l): ?>
          <option value="<?=$v?>" <?=$cur['card_profile'] === $v ? 'selected' : ''?>><?=$l?></option>
          <?php endforeach; ?>
        </select>
        <p class="cmp-note">Leave on Auto-detect. A profile that contradicts the detected card is refused at boot.</p></td></tr>
      <tr><td><b>PCIe Gen2 retrain</b></td><td>
        <select name="gen2">
          <option value="true" <?=$cur['gen2_enable'] === 'true' ? 'selected' : ''?>>Enabled</option>
          <option value="false" <?=$cur['gen2_enable'] === 'false' ? 'selected' : ''?>>Disabled</option>
        </select>
        <p class="cmp-note">Reloads the driver once at boot and retrains the link to Gen2 (cmpunlocker hammer). Applies at next boot.</p></td></tr>
      <tr><td><b>Update notifications</b></td><td>
        <select name="notify">
          <option value="true" <?=$cur['update_check'] === 'true' ? 'selected' : ''?>>Enabled</option>
          <option value="false" <?=$cur['update_check'] === 'false' ? 'selected' : ''?>>Disabled</option>
