<?php
$name = 'cmp170hx-unlock-driver';
$cmp  = "/usr/local/emhttp/plugins/$name/include/cmp.sh";

// Save settings (same-page POST; cmp.sh validates every value again)
$saved = false;
if (isset($_POST['cmp_save'])) {
  $fields = ['driver_version' => 'drv', 'cmpunlocker_ref' => 'ref', 'card_profile' => 'profile', 'gen2_enable' => 'gen2', 'update_check' => 'notify'];
  foreach ($fields as $key => $field) {
    $val = $_POST[$field] ?? '';
    if ($val !== '') shell_exec("$cmp set " . escapeshellarg($key) . ' ' . escapeshellarg($val) . ' 2>&1');
  }
  $saved = true;
}
$s = is_readable("/boot/config/plugins/$name/settings.cfg") ? (parse_ini_file("/boot/config/plugins/$name/settings.cfg", false, INI_SCANNER_RAW) ?: []) : [];
$cur = array_merge(['driver_version' => 'latest', 'cmpunlocker_ref' => 'latest', 'card_profile' => 'auto', 'gen2_enable' => 'true', 'update_check' => 'true'], $s);
?>

<script>
if (window.history.replaceState) { window.history.replaceState(null, null, window.location.href); }
var CMP_BASE = '/plugins/<?=$name?>/include/';
var CMP_SETTINGS = <?=json_encode($cur)?>;

function esc(v) {
  return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function chip(text, kind) { return '<span class="cmp-chip cmp-' + kind + '">' + esc(text) + '</span>'; }
function banner(kind, title, body) {
  return '<div class="cmp-banner cmp-b-' + kind + '"><b>' + esc(title) + '</b><br>' + body + '</div>';
}

// Banners describe the system as it is now (driver loaded, packages, cards, published support), not what
// happened at boot; the boot result only adds the reason when the driver is missing.
function renderBanners(d) {
  var h = '', st = (d.state && d.state.status) || '', det = (d.state && d.state.detail) || '';
  var want = (d.settings && d.settings.card_profile) || 'auto', det_prof = d.detected_profile;
  var reboot = 'reboot (a full power-off the first time, so the card unlocks)';
  if (d.conflict) {
    h += banner('bad', 'Plugin conflict', 'The Nvidia Driver plugin is installed. It cannot run together with this plugin: remove one of them and reboot. No patched driver is installed while both are present.');
  } else if (det_prof && want !== 'auto' && want !== 'mixed' && want !== det_prof) {
    h += banner('bad', 'Card profile mismatch', 'The card profile setting (' + esc(want) + ') contradicts the detected card (' + esc(det_prof) + '). Set it to Auto-detect and reboot.');
  } else if (d.module.version) {
    if (d.gpus.some(function(g) { return g.unlock === 'stock'; })) {
      h += banner('warn', 'Cold boot required', 'The driver is loaded but the card still reports stock memory. Shut the server <b>down completely</b>, wait until power fully drops, then power on. A reboot is not enough.');
    } else if (d.gpus.length && d.gpus.every(function(g) { return g.unlock === 'unlocked'; })) {
      h += banner('ok', 'Driver active, card unlocked', 'Patched driver ' + esc(d.module.version) + ' is loaded and every CMP 170HX reports its full memory.');
    }
  } else if (d.installed_package) {
    h += banner(d.cards.length ? 'bad' : 'warn', 'Driver installed but not loaded', 'The patched driver packages are installed, but the nvidia kernel module did not load.' + (d.cards.length ? ' Use <i>Download diagnostics</i> and check the system log.' : ' No CMP 170HX is in this server, so this is expected with a forced card profile.'));
  } else if (!d.cards.length && want === 'auto') {
    h += banner('warn', 'No CMP 170HX detected', 'No supported card was found on the PCI bus, so no driver is installed. Install the card, or pick a card profile below.');
  } else if (d.kernel_support === 'unsupported') {
    h += banner('bad', 'Kernel ' + esc(d.kernel) + ' is not supported yet', 'No patched driver is published for this Unraid version, so <b>no GPU driver is installed</b>. Your array and Docker are unaffected. Once support is published this page says so; then download it and ' + reboot + '. Your settings are kept.');
  } else if (d.kernel_support === 'supported') {
    h += banner('warn', 'No driver installed yet', (d.cached_package
      ? 'The patched driver for kernel ' + esc(d.kernel) + ' is downloaded. To install it, ' + reboot + '.'
      : 'A patched driver for kernel ' + esc(d.kernel) + ' is available. Click <i>Download package now</i>, then ' + reboot + '.')
      + (st === 'error' ? '<br>Last boot: ' + esc(det) + '.' : ''));
  } else if (d.kernel_support === 'unknown') {
    h += banner('warn', 'No driver installed', 'The release server cannot be reached, so it is unknown whether a driver exists for kernel ' + esc(d.kernel) + '. Check the internet connection and use <i>Re-check now</i>.');
  }
  (d.upgrade && d.upgrade.results || []).forEach(function(r) {
    if (r.status === 'unsupported') {
      h += banner('bad', 'Do not upgrade to Unraid ' + r.version + ' yet', 'Unraid ' + esc(r.version) + ' uses kernel ' + esc(r.kernel) + ', and no patched CMP 170HX driver is published for it yet. Upgrading now leaves the GPU <b>without a driver</b> until support is added. Wait until this page lists the release as supported.');
    } else if (r.status === 'unknown') {
      h += banner('warn', 'Unraid ' + r.version + ': support unknown', 'Could not determine which kernel Unraid ' + esc(r.version) + ' uses, so its support cannot be verified. Hold off upgrading until it shows as supported.');
    }
  });
  document.getElementById('cmp-banners').innerHTML = h;
}

function unlockChip(g) {
  switch (g.unlock) {
    case 'unlocked':   return chip('Unlocked', 'ok');
    case 'stock':      return chip('Stock memory (not unlocked)', 'bad');
    case 'unexpected': return chip('Unexpected memory size', 'warn');
    default:           return chip('Not a CMP 170HX', 'dim');
  }
}

function renderStatus(d) {
  var h = '<table class="cmp-table">';
  h += '<tr><td>Unraid</td><td>' + esc(d.unraid_version) + ' (kernel ' + esc(d.kernel) + ')</td></tr>';
  var ks = {supported: chip('Patched driver available', 'ok'), unsupported: chip('Not supported yet', 'bad'), unknown: chip('Cannot verify', 'warn'), '': chip('Not checked yet', 'dim')};
  h += '<tr><td>Kernel support</td><td>' + (ks[d.kernel_support] || ks['']) + '</td></tr>';
  h += '<tr><td>Driver</td><td>' + (d.module.version ? esc(d.module.version) + ' ' + chip(/GPL|MIT/i.test(d.module.license) ? 'open-source kernel module' : esc(d.module.license), 'dim') : chip('Not loaded', 'bad')) + '</td></tr>';
  h += '<tr><td>Installed packages</td><td>' + (d.installed_package ? esc(d.installed_package).replace(/\n/g, '<br>') : '<i>none</i>') + '</td></tr>';
  h += '<tr><td>Cached for next boot</td><td>' + (d.cached_package ? esc(d.cached_package).replace(/\n/g, '<br>') : '<i>none</i>') + '</td></tr>';
  h += '<tr><td>Detected card(s)</td><td>' + (d.cards.length ? d.cards.map(function(c) { return esc(c.slot) + ' (' + esc(c.profile) + ' model)'; }).join('<br>') : '<i>none</i>') + '</td></tr>';
  h += '</table>';
  document.getElementById('cmp-status').innerHTML = h;

  var g = '';
  if (!d.gpus.length) {
    g = '<p><i>No GPU reported by the driver.</i></p>';
  } else {
    d.gpus.forEach(function(x) {
      g += '<div class="cmp-gpu"><b>' + esc(x.index) + ': ' + esc(x.name) + '</b> <span class="cmp-dim">' + esc(x.bus) + '</span><br>';
      g += 'Memory: <b>' + esc((x.memory_mib / 1024).toFixed(1)) + ' GiB</b> (' + esc(x.memory_mib) + ' MiB) ' + unlockChip(x) + '<br>';
      g += 'PCIe link: gen ' + esc(x.gen_current) + ' now, max ' + esc(x.gen_max) + ' <span class="cmp-dim">(the link may idle at a lower gen)</span><br>';
      g += 'ECC: ' + esc(x.ecc) + '</div>';
    });
  }
  document.getElementById('cmp-gpus').innerHTML = g;

  var hc = '<table class="cmp-table">';
  hc += '<tr><td>Driver loaded</td><td>' + (d.module.version ? chip('OK', 'ok') : chip('No', 'bad')) + '</td></tr>';
  hc += '<tr><td>GPU memory unlocked</td><td>' + (d.gpus.length && d.gpus.every(function(x) { return x.unlock === 'unlocked'; }) ? chip('OK', 'ok') : chip('No', 'bad')) + '</td></tr>';
  hc += '<tr><td>Unlock marker in kernel log</td><td>' + (d.pma_ok ? chip('OK', 'ok') : chip('Not found', 'warn')) + ' <span class="cmp-dim">late PMA extension status=0x0</span></td></tr>';
  hc += '<tr><td>Gen2 retrain log</td><td><code>' + (d.gen2_log ? esc(d.gen2_log).replace(/\n/g, '<br>') : 'no log') + '</code></td></tr>';
  hc += '</table>';
  document.getElementById('cmp-health').innerHTML = hc;

  var u = '';
  if (d.upgrade && d.upgrade.results && d.upgrade.results.length) {
    u += '<table class="cmp-table">';
    d.upgrade.results.forEach(function(r) {
      var c = r.status === 'supported' ? chip('Supported - safe to upgrade', 'ok') : (r.status === 'unsupported' ? chip('NOT supported yet - do not upgrade', 'bad') : chip('Cannot verify', 'warn'));
      u += '<tr><td>Unraid ' + esc(r.version) + ' <span class="cmp-dim">(' + esc(r.branch) + ', kernel ' + esc(r.kernel || '?') + ')</span></td><td>' + c + '</td></tr>';
    });
    u += '</table>';
  } else if (d.upgrade) {
    u = '<p>No newer Unraid release found for your branch.</p>';
  } else {
    u = '<p><i>Not checked yet.</i></p>';
  }
  document.getElementById('cmp-upgrade').innerHTML = u;

  fillOptions(d);
  renderBanners(d);
}

function uniq(a) { return a.filter(function(v, i) { return a.indexOf(v) === i; }); }
function fillSelect(id, values, selected) {
  var el = document.getElementById(id);
  var opts = uniq(['latest'].concat(values));
  if (selected && opts.indexOf(selected) < 0) opts.push(selected);
  el.innerHTML = opts.map(function(v) { return '<option value="' + esc(v) + '"' + (v === selected ? ' selected' : '') + '>' + (v === 'latest' ? 'Latest' : esc(v)) + '</option>'; }).join('');
}
function fillOptions(d) {
  var a = d.available || [];
  fillSelect('cmp-drv', a.map(function(p) { return p.driver; }).sort().reverse(), CMP_SETTINGS.driver_version);
  fillSelect('cmp-ref', a.map(function(p) { return p.cmpunlocker; }).sort().reverse(), CMP_SETTINGS.cmpunlocker_ref);
}

function loadStatus(refresh) {
  var url = CMP_BASE + 'status.php?_=' + Date.now() + (refresh ? '&refresh=' + refresh : '');
  return fetch(url, {cache: 'no-store'})
    .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(renderStatus)
    .catch(function(e) { document.getElementById('cmp-banners').innerHTML = banner('bad', 'Could not load status', esc(e.message)); });
}
function recheck() {
  var b = document.getElementById('cmp-recheck'); b.disabled = true; b.value = 'Checking...';
  loadStatus('force').then(function() { b.disabled = false; b.value = 'Re-check now'; });
}
function downloadPkg() {
  openBox('/usr/local/emhttp/plugins/<?=$name?>/include/cmp.sh&arg1=download', 'Downloading driver package', 400, 700, true);
}

document.addEventListener('DOMContentLoaded', function() {
  loadStatus().then(function() { loadStatus(1); });
});
</script>

<style>
.cmp-wrap { display:flex; flex-wrap:wrap; gap:24px; justify-content:center; align-items:flex-start; }
.cmp-col { flex:1 1 520px; max-width:760px; min-width:0; }
.cmp-table td { padding:4px 12px 4px 0; vertical-align:top; line-height:normal; }
.cmp-table td:first-child { white-space:nowrap; opacity:.8; }
.cmp-chip { display:inline-block; padding:1px 8px; border-radius:10px; font-size:.85em; color:#fff; }
.cmp-ok { background:#2e8b3d; } .cmp-bad { background:#c0392b; } .cmp-warn { background:#b9770e; } .cmp-dim { opacity:.65; }
span.cmp-chip.cmp-dim { background:#666; opacity:1; }
.cmp-banner { padding:10px 14px; margin:8px 0; border-left:5px solid; border-radius:3px; }
.cmp-b-bad { border-color:#c0392b; background:rgba(192,57,43,.12); }
.cmp-b-warn { border-color:#b9770e; background:rgba(185,119,14,.12); }
.cmp-b-ok { border-color:#2e8b3d; background:rgba(46,139,61,.12); }
.cmp-gpu { margin:8px 0 14px; line-height:1.6; }
.cmp-form { width:100%; table-layout:fixed; }
.cmp-form td { padding:6px 12px 6px 0; vertical-align:top; line-height:normal; white-space:normal; overflow-wrap:anywhere; }
.cmp-form td:first-child { width:170px; }
.cmp-form select { width:auto; min-width:180px; max-width:100%; }
.cmp-note { font-size:.9em; opacity:.8; margin:2px 0 0; }
</style>

<h1 style="text-align:center">CMP 170HX Unlock Driver</h1>

<?php if ($saved): ?>
<div class="cmp-banner cmp-b-warn" style="max-width:1100px;margin:8px auto"><b>Settings saved.</b> Click <i>Download package now</i> to fetch a changed driver version, then reboot to apply it.</div>
<?php endif; ?>

<div id="cmp-banners" style="max-width:1100px;margin:0 auto"></div>

<div class="cmp-wrap">

<div class="cmp-col">
  <p><b><font size="+1">Status</font></b></p>
  <div id="cmp-status"><i>Loading...</i></div>
  <br>
  <p><b><font size="+1">GPU</font></b></p>
  <div id="cmp-gpus"><i>Loading...</i></div>
  <p><b><font size="+1">Health checks</font></b></p>
  <div id="cmp-health"><i>Loading...</i></div>
  <br>
  <p><b><font size="+1">Before you upgrade Unraid</font></b></p>
  <div id="cmp-upgrade"><i>Loading...</i></div>
